classDiagram
direction LR

%% ===== Screen (top-level composable) =====
class Catalog {
  <<composable - screen>>
  +title: String
  +root: Page
  +onBack: OnBack
  +backEnabled: Boolean
  +showBackButton: Boolean
  +adaptiveInfo: WindowAdaptiveInfo?
  +singlePaneOnly: Boolean
  +options: CatalogOptions
}

class CatalogOptions {
  +hingePolicy: HingePolicy
  +twoPanesOnMediumWidth: Boolean
  +fadingEdges: Boolean
  +paneGap: Dp
  +pageTransition: PageTransition
}

class PageTransition {
  <<sealed>>
  None / Fade / Slide / SlideFade
  +durationMs: Int
  +easing: Easing
  endpoints(direction, width)*
  Custom(durationMs, easing, transform)
}
class PageDirection {
  <<enum>>
  Forward / Backward
}
class PageTransitionEndpoints {
  <<data>>
  +enterOffset: Dp
  +enterAlpha: Float
  +exitOffset: Dp
  +exitAlpha: Float
}

class ScreenAdaptive {
  <<internal>>
  +isTwoPane: Boolean
  +directive: PaneScaffoldDirective
  rememberScreenAdaptive()*
  quantizedAdaptiveInfo()*
  paneScaffoldDirective()*
}

class ListPane {
  <<composable - internal>>
}
class DetailPane {
  <<composable - internal>>
}
class FullScreenSearch {
  <<composable - internal>>
}
class BreadcrumbBar {
  <<composable - internal>>
}
class SearchEntry {
  <<data - internal>>
  +id: Int
  +page: Page
  +path: String
  +entry: SearchIndexEntry?
}

%% ===== Page model =====
class Page {
  <<data - model>>
  +id: String
  +title: String
  +summary: String?
  +icon: Composable?
  +contentVersion: Int
  +content: ContentBuilder
  structure (lazy, derived)
  childPages (derived)
  walkPages()*
  findPage(root, id)*
  findPagePath(root, id)*
  searchPages(root, index, query)*
}

class PageMatch {
  <<data - search result>>
  +page: Page
  +matches: List~SearchIndexEntry~
}

%% ===== Search =====
class SearchIndex {
  <<static functions>>
  buildPageStructure(root)*
  buildSearchIndex(root)*
}
class PageStructure {
  <<data>>
  +entries: List~SearchIndexEntry~
  +subPages: List~SubPageRef~
}
class SubPageRef {
  <<data>>
  +page: Page
  +onClick: OnClick?
  +index: Int
}
class SearchIndexEntry {
  <<data>>
  +key: String?
  +title: String
  +summary: String?
  +index: Int
  +titleLowercase: String
  +summaryLowercase: String?
}

%% ===== State / persistence =====
class Store {
  <<interface>>
  +get(key): T?
  +asMap(): Map~String, Any~
  +toMutableStore(): MutableStore
}
class MutableStore {
  <<interface>>
  +set(key, value: T?)
  +remove(key)
  +clear()
}
class MapStore
class MutableMapStore

class LocalStore {
  <<state flow>>
  LocalStore
  createDefaultStore()*
  createStore()*
  ProvideStore()*
  rememberValue(key)*
}

%% ===== Theming =====
class ItemTheme {
  +categoryPadding: PaddingValues
  +categoryColor: Color
  +padding: PaddingValues
  +titleColor: Color
  +titleTextStyle: TextStyle
  +summaryColor: Color
  +summaryTextStyle: TextStyle
  +dividerHeight: Dp
  itemTheme()*
  LocalItemTheme
}

%% ===== Item widgets (each = LazyListScope builder + Composable) =====
class Item {
  <<composable - item family>>
  +page: Page? (optional item that opens a page)
  +style: CardStyle? (drawn in a card of this style)
  +cardColor / cardElevation / cardBorder / shape / outerPadding
}
class BasicItem {
  <<composable>>
}
class ItemCheckbox {
  <<composable>>
}
class ItemSwitch {
  <<composable>>
}
class ItemRadio {
  <<composable>>
}
class ItemSlider {
  <<composable>>
}
class ItemTextField {
  <<composable>>
}
class ItemList {
  <<composable>>
}
class ItemMultiSelectList {
  <<composable>>
}
class ItemActions {
  <<composable>>
}
class ItemActionIconButton {
  <<composable>>
}
class ItemActionsSwitch {
  <<composable>>
}
class Section {
  <<composable - section header>>
}
class ItemColorList {
  <<composable>>
}
class ColorOption {
  <<data>>
}

%% ===== Card style + group (a card is a style, group is layout) =====
class CardStyle {
  <<sealed>>
  Filled
  Elevated
  Outlined
  None (no card)
}
class GroupItem {
  <<data>>
  +title: String
  +summary: String?
  +page: Page?
  +content: Composable
  +onClick: (() -> Unit)?
}
class Group {
  <<composable>>
  +style: CardStyle = Filled
  +cardColor: Color?
  +items: List~GroupItem~
}
class GroupScope {
  <<dsl scope>>
  item()*
}

%% ===== External (material3-adaptive) =====
class WindowAdaptiveInfo {
  <<external - m3 adaptive>>
}
class HingePolicy {
  <<external - m3 adaptive>>
}

%% ===== Relationships =====
MutableStore --|> Store
MapStore --|> Store
MutableMapStore --|> MutableStore

Catalog --> Page : root
Catalog --> CatalogOptions : options
CatalogOptions --> HingePolicy : hingePolicy
CatalogOptions --> PageTransition : pageTransition
PageTransition --> PageDirection : endpoints(direction, width)
PageTransition --> PageTransitionEndpoints : endpoints()
Catalog ..> ScreenAdaptive : remembers
Catalog ..> ItemTheme : consumes
Catalog ..> SearchIndex : builds
Catalog o-- ListPane : composes
Catalog o-- DetailPane : composes
Catalog o-- FullScreenSearch : composes (search overlay)
ListPane ..> BreadcrumbBar : single-pane
ListPane ..> SearchEntry : search results
DetailPane ..> SearchEntry : search results
DetailPane ..> Page : renders content
FullScreenSearch ..> SearchEntry : results

Page --> Page : childPages (derived from content)
Page ..> PageStructure : structure (walk of content)
PageStructure --> SearchIndexEntry : entries
PageStructure --> SubPageRef : subPages
SubPageRef --> Page : page
PageMatch --> Page : page
PageMatch --> SearchIndexEntry : matches
SearchIndex ..> SearchIndexEntry : builds
SearchIndex ..> Page : walks
SearchIndex ..> PageStructure : builds
SearchEntry --> Page : page
SearchEntry ..> SearchIndexEntry : entry
Item ..> Page : page item (optional)

ItemCheckbox ..> LocalStore : reads state
ItemSlider ..> LocalStore : reads state
ItemTextField ..> LocalStore : reads state
Item ..> ItemTheme : styled by
Item ..> LocalStore : reads state
DetailPane ..> Item : renders items

BasicItem --|> Item : is a
ItemCheckbox --|> Item : is a
ItemSwitch --|> Item : is a
ItemRadio --|> Item : is a
ItemSlider --|> Item : is a
ItemTextField --|> Item : is a
ItemList --|> Item : is a
ItemMultiSelectList --|> Item : is a
ItemActions --|> Item : is a
ItemActionIconButton --|> Item : is a
ItemActionsSwitch --|> Item : is a
Section --|> Item : is a

Group ..> GroupScope : dsl
Group ..> CardStyle : style
Group --> GroupItem : items
GroupItem --> Page : page (optional)
GroupItem ..> Item : rendered as
Item ..> CardStyle : style (item style param)
Page ..> Group : via a group item with a Page
ItemColorList --|> Item : is a
ItemColorList ..> ColorOption : options
